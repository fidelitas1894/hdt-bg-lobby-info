<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BgLobbyInfo</AssemblyName>
    <RootNamespace>BgLobbyInfo</RootNamespace>
    <Version>0.4.2</Version>
    <!-- Keine lokalen Pfade in die DLL schreiben (kein PDB-Verweis, Quellpfade neutralisiert) -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- HDT-Installation: automatisch der (alphabetisch) letzte app-*-Ordner; überschreibbar mit -p:HdtDir=... -->
    <_HdtRoot>$(LOCALAPPDATA)\HearthstoneDeckTracker</_HdtRoot>
    <_HdtDirs Condition="Exists('$(_HdtRoot)')">$([System.String]::Join(';', $([System.IO.Directory]::GetDirectories($(_HdtRoot), 'app-*'))))</_HdtDirs>
    <HdtDir Condition="'$(HdtDir)' == '' and '$(_HdtDirs)' != ''">$(_HdtDirs.Split(';').GetValue($([MSBuild]::Subtract($(_HdtDirs.Split(';').Length), 1))))</HdtDir>
    <HdtPluginDir>$(APPDATA)\HearthstoneDeckTracker\Plugins\BgLobbyInfo</HdtPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker"><HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="HearthDb"><HintPath>$(HdtDir)\HearthDb.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HearthMirror"><HintPath>$(HdtDir)\HearthMirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- dotnet build -p:Deploy=true kopiert die DLL direkt in den HDT-Plugin-Ordner -->
  <Target Name="DeployToHdt" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(HdtPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HdtPluginDir)" />
  </Target>

</Project>
